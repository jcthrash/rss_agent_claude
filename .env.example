# ── Required ──────────────────────────────────────────────────────────────────
# Anthropic API key — used by filter_and_rank.py for LLM scoring with Claude Haiku.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# ── Optional ──────────────────────────────────────────────────────────────────

# Bluesky handle — only needed for eval_pipeline.py (precision/recall evaluation).
# If you share papers on Bluesky, this lets the eval tool compare pipeline output
# against what you actually posted.
# BLUESKY_HANDLE=yourhandle.bsky.social

# Maximum number of articles to send to the LLM ranker per run.
# Lower values save API costs; higher values improve recall.
# Default in run_pipeline.sh is 2000.
# MAX_LLM=400

# Crossref polite-pool email — providing your email gives you faster, more
# reliable access to the Crossref API. See https://www.crossref.org/documentation/
# CROSSREF_MAILTO=you@example.com
